# Supabase project credentials.
#
# 1. Create a project at https://supabase.com
# 2. Open Settings → API
# 3. Copy "Project URL" and the "anon / public" key below.
#
# The anon key is safe to expose to the browser; all reads go through
# admin-scoped RLS (for commissioners) or code-gated RPC functions
# (for participants on /league/{code}).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: project ref (the subdomain of SUPABASE_URL, e.g. "qjrhrqeqpztqkctjvhlb").
# Only used by `npm run db:types` to regenerate src/lib/supabase/types.generated.ts
# after applying migrations. Safe to leave unset in normal development.
# SUPABASE_PROJECT_ID=your-project-ref
